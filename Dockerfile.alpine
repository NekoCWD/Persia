FROM golang:1.27-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/persia ./cmd/persia

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 1000 -h /home/persia persia \
    && mkdir -p /data /etc/persia \
    && chown -R persia:persia /data /etc/persia

COPY --from=build /out/persia /usr/local/bin/persia

# Notification templates. They are plain files, so they can be overridden by
# mounting a directory over /etc/persia/messages in docker-compose.
COPY messages /etc/persia/messages

# Run from /etc/persia so relative paths in config.yaml (for example
# shortlink_template: "./shortlink.example.tmpl" and
# message_templates: "./messages") resolve the same way they do outside the
# container.
WORKDIR /etc/persia

USER persia
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/persia", "run", "-config", "/etc/persia/config.yaml"]
