# Secrets for Persia. Copy to .env and fill in.
# The config file references these variables through ${...}.

PERSIA_FORGEJO_TOKEN=
PERSIA_MATRIX_TOKEN=
PERSIA_GITHUB_TOKEN=
PERSIA_GITLAB_TOKEN=
PERSIA_ALTLINUX_TOKEN=

# Overrides the database path from config.yaml.
PERSIA_DATABASE=./data/persia.db
